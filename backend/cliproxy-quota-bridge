def get_claude_pool_status():
    global _cached_claude_accounts, _last_claude_probe_time
    now = time.time()
    if now - _last_claude_probe_time < PROBE_CACHE_SEC and _cached_claude_accounts:
        return _cached_claude_accounts

    try:
        tasks = []
        if os.path.exists(ACCOUNTS_FILE):
            with open(ACCOUNTS_FILE, encoding="utf-8") as f:
                acc_data = json.load(f)
            claude_info = acc_data.get("providers", {}).get("claude", {})
            ordered_ids = claude_info.get("drainOrder", {}).get("orderedIds", [])
            accounts_dict = claude_info.get("accounts", {})
            for em in ordered_ids:
                acc = accounts_dict.get(em, {})
                tf = acc.get("tokenFile", f"claude-{em}.json")
                nick = acc.get("nickname", em)
                tasks.append((em, tf, nick))
        
        if not tasks and os.path.exists(AUTH_DIR):
            for fn in sorted(os.listdir(AUTH_DIR)):
                if fn.startswith("claude-") and fn.endswith(".json"):
                    em = fn[len("claude-"):-len(".json")]
                    tasks.append((em, fn, em))

        if tasks:
            results = []
            for idx, task in enumerate(tasks):
                res = _probe_single_claude(task)
                results.append(res)
                # Anti-burst human cadence stagger: 0.35s delay between sequential accounts
                if idx < len(tasks) - 1:
                    time.sleep(0.35)
            
            _cached_claude_accounts = results
            _last_claude_probe_time = now
            return results
    except Exception:
        pass

    if _cached_claude_accounts:
        return _cached_claude_accounts
    return []

def set_claude_accounts_order(ordered_emails):
    """Native implementation of account order and priority management (Zero CCS dependency)."""
    global _last_claude_probe_time
    if not ordered_emails or not isinstance(ordered_emails, list):
        return False

    # 1. Update accounts.json drainOrder
    try:
        if os.path.exists(ACCOUNTS_FILE):
            with open(ACCOUNTS_FILE, "r", encoding="utf-8") as f:
                acc_data = json.load(f)
            if "providers" in acc_data and "claude" in acc_data["providers"]:
                if "drainOrder" not in acc_data["providers"]["claude"]:
                    acc_data["providers"]["claude"]["drainOrder"] = {"mode": "manual"}
                acc_data["providers"]["claude"]["drainOrder"]["orderedIds"] = ordered_emails
                acc_data["providers"]["claude"]["drainOrder"]["mode"] = "manual"
                with open(ACCOUNTS_FILE, "w", encoding="utf-8") as f:
                    json.dump(acc_data, f, indent=2)
    except Exception:
        pass

    # 2. Update priority in auth files via CLIProxy official Management API (with atomic disk fallback)
    total = len(ordered_emails)
    for idx, em in enumerate(ordered_emails):
        prio = max(1, total - idx + 1)
        fn = f"claude-{em}.json"
        
        # Official CLIProxy PATCH /v0/management/auth-files/fields
        try:
            req = urllib.request.Request(
                "http://127.0.0.1:8317/v0/management/auth-files/fields",
                data=json.dumps({"name": fn, "priority": prio}).encode("utf-8"),
                headers={
                    "Authorization": f"Bearer {MANAGEMENT_SECRET}",
                    "Content-Type": "application/json"
                },
                method="PATCH"
            )
            with urllib.request.urlopen(req, timeout=3) as resp:
                pass
        except Exception:
            # Fallback file write if proxy is temporarily offline
            auth_path = os.path.join(AUTH_DIR, fn)
            if os.path.exists(auth_path):
                try:
                    with open(auth_path, "r", encoding="utf-8") as fp:
                        ad = json.load(fp)
                    ad["priority"] = prio
                    with open(auth_path, "w", encoding="utf-8") as fp:
                        json.dump(ad, fp, indent=2)
                except Exception:
                    pass

    _last_claude_probe_time = 0
    return True

class BridgeHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path.startswith("/v1/antigravity-quota"):
            self.handle_antigravity()
        elif self.path.startswith("/v1/pool-status"):
            self.handle_pool_status()
        elif self.path.startswith("/v1/keeper-telemetry"):
            self.handle_keeper_telemetry()
        else:
            self.handle_pool_status()

    def do_POST(self):
        if self.path.startswith("/v1/set-priority"):
            self.handle_set_priority()
        elif self.path.startswith("/v1/set-order"):
            self.handle_set_order()
        else:
            self.send_response(404)
            self.end_headers()

    def handle_set_order(self):
        try:
            content_length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(content_length)
            req_data = json.loads(body.decode("utf-8"))
            new_order = req_data.get("order", [])
            if set_claude_accounts_order(new_order):
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"ok": True, "order": new_order}).encode("utf-8"))
            else:
                self.send_response(400)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"error": "Invalid order list"}).encode("utf-8"))
        except Exception as e:
            self.send_response(500)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"error": str(e)}).encode("utf-8"))

    def handle_set_priority(self):
        try:
            content_length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(content_length)
            req_data = json.loads(body.decode("utf-8"))
            target_email = req_data.get("email")
            
            pool = get_claude_pool_status()
            emails = [a["email"] for a in pool]
            if target_email in emails:
                emails.remove(target_email)
                new_order = [target_email] + emails
                set_claude_accounts_order(new_order)
                
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"ok": True, "target": target_email, "order": new_order}).encode("utf-8"))
            else:
                self.send_response(404)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"error": f"Account {target_email} not in pool"}).encode("utf-8"))
        except Exception as e:
            self.send_response(500)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"error": str(e)}).encode("utf-8"))

    def handle_keeper_telemetry(self):
        try:
            timer_info = {
                "status": "active",
                "schedule": "Mỗi 4 giờ (Proactive Refresh)",
                "next_run": "22:00:00",
                "last_run": "18:00:00"
            }
            logs = []
            last_dt = None
            if os.path.exists(LOG_FILE):
                with open(LOG_FILE, "r", encoding="utf-8", errors="ignore") as lf:
                    lines = lf.readlines()
                    logs = [l.strip() for l in lines[-25:] if l.strip()]
                    for l in reversed(logs):
                        m = re.search(r"\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\]", l)
                        if m:
                            try:
                                last_dt = datetime.datetime.strptime(m.group(1), "%Y-%m-%d %H:%M:%S")
                                timer_info["last_run"] = last_dt.strftime("%H:%M:%S")
                                next_dt = last_dt + datetime.timedelta(hours=4)
                                timer_info["next_run"] = next_dt.strftime("%H:%M:%S")
                                break
                            except Exception:
                                pass

            now_dt = datetime.datetime.now()
            if not last_dt:
                last_dt = now_dt - datetime.timedelta(minutes=5)
                timer_info["last_run"] = last_dt.strftime("%H:%M:%S")
                next_dt = last_dt + datetime.timedelta(hours=4)
                timer_info["next_run"] = next_dt.strftime("%H:%M:%S")
            else:
                next_dt = last_dt + datetime.timedelta(hours=4)

            elapsed_sec = max(0, (now_dt - last_dt).total_seconds())
            cycle_sec = 4 * 3600
            cycle_percent = min(100.0, max(0.0, (elapsed_sec / cycle_sec) * 100.0))
            rem_sec = max(0, int((next_dt - now_dt).total_seconds()))
            rem_h = rem_sec // 3600
            rem_m = (rem_sec % 3600) // 60
            if rem_h > 0:
                time_left_str = f"còn {rem_h}h {rem_m}m"
            elif rem_m > 0:
                time_left_str = f"còn {rem_m}m"
            else:
                time_left_str = "đang chạy..."

            timer_info["cycle_percent"] = round(cycle_percent, 1)
            timer_info["time_left"] = time_left_str

            backup_count = len(os.listdir(VAULT_DIR)) if os.path.exists(VAULT_DIR) else 0

            payload = {
                "timer": timer_info,
                "service": "claude-token-keeper.service",
                "description": "Bảo vệ phiên, tự động refresh OAuth access_token trước khi hết hạn",
                "backup_count": backup_count,
                "logs": logs
            }
            res_bytes = json.dumps(payload, ensure_ascii=False).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.end_headers()
            self.wfile.write(res_bytes)
        except Exception as e:
            self.send_response(500)
            self.end_headers()
            self.wfile.write(json.dumps({"error": str(e)}).encode("utf-8"))

