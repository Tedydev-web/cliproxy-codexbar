                plan = "Max 20x"
            elif "5x" in tier:
                plan = "Max 5x"
            elif "max" in tier:
                plan = "Max"
            elif "pro" in tier:
                plan = "Pro"
            elif "team" in tier:
                plan = "Team"
            else:
                plan = "Max"
            _account_plan_cache[email] = plan
            return plan
    except Exception:
        if "trthuhuyen" in email:
            return "Max 5x"
        elif "project" in email:
            return "Max 20x"
        return "Max"

def _probe_single_claude(item):
    email, token_file, nickname = item
    prev = next((a for a in _cached_claude_accounts if a.get("email") == email), None)
    now = time.time()
    
    # Smart Cache: If account is known to be weekly-exhausted and reset is hours away, skip probe to protect session
    if prev and prev.get("remaining_weekly") == 0 and not prev.get("is_probe_error"):
        last_t = _account_probe_timestamps.get(email, 0)
        if now - last_t < EXHAUSTED_CACHE_SEC:
            return prev

    auth_path = os.path.join(AUTH_DIR, token_file)
    if not os.path.exists(auth_path):
        return {
            "email": email,
            "name": nickname or email,
            "is_available": False,
            "is_probe_error": True,
            "status_text": "Không tìm thấy file token",
            "error_hint": "Thiếu credential file",
            "remaining_5h": 0, "used_5h": 100, "reset_5h": "",
            "remaining_weekly": 0, "used_weekly": 100, "reset_weekly": "",
            "plan": get_claude_plan_tier(email)
        }
    
    try:
        with open(auth_path, encoding="utf-8") as f:
            auth_d = json.load(f)
        token = auth_d.get("access_token")
        if not token:
            raise ValueError("No access token")
        
        # Exact official Claude Code 2.1.296 headers
        req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
            "Authorization": f"Bearer {token}",
            "User-Agent": "claude-cli/2.1.296 (external, cli)",
            "Accept": "application/json"
        })
        with urllib.request.urlopen(req, timeout=4) as resp:
            data = json.loads(resp.read().decode())
        
        fh = data.get("five_hour") or {}
        sd = data.get("seven_day") or {}
        
        fh_util = fh.get("utilization") or 0.0
        sd_util = sd.get("utilization") or 0.0
        
        u_5h = int(round(fh_util))
        rem_5h = max(0, 100 - u_5h)
        r_5h = fmt_relative_reset(fh.get("resets_at"))
        
        u_wk = int(round(sd_util))
        rem_wk = max(0, 100 - u_wk)
        r_wk = fmt_relative_reset(sd.get("resets_at"))
        
        is_avail = (rem_5h > 0 and rem_wk > 0)
        _account_probe_timestamps[email] = now
        
        return {
            "email": email,
            "name": nickname or email,
            "is_available": is_avail,
            "is_probe_error": False,
            "status_text": "Khả dụng" if is_avail else "Hết hạn",
            "error_hint": "",
            "remaining_5h": rem_5h,
            "used_5h": u_5h,
            "reset_5h": r_5h,
            "remaining_weekly": rem_wk,
            "used_weekly": u_wk,
            "reset_weekly": r_wk,
            "plan": get_claude_plan_tier(email)
        }
    except Exception as e:
        is_429 = "429" in str(e)
        rem_5h = prev["remaining_5h"] if prev else 0
        u_5h = prev["used_5h"] if prev else 100
        r_5h = prev["reset_5h"] if prev else ""
        rem_wk = prev["remaining_weekly"] if prev else 0
        u_wk = prev["used_weekly"] if prev else 100
        r_wk = prev["reset_weekly"] if prev else ""
        is_avail = prev["is_available"] if prev else False
        
        return {
            "email": email,
            "name": nickname or email,
            "is_available": is_avail,
            "is_probe_error": True,
            "status_text": "Tạm nghẽn probe (429 upstream)" if is_429 else "Lỗi kết nối probe",
            "error_hint": "Anthropic usage API bị 429 tạm thời (Inference vẫn khả dụng)" if is_429 else str(e),
